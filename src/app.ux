<script>
import router from "@system.router"
import app from '@system.app'
import * as uiAdm from './common/js/uiAdm'
import { getDeviceInfo, getSettings } from './common/js/useful.js'
import * as storageManager from "./common/js/storage.js"
import * as fetchManager from "./common/js/fetch.js"
import { initInterconnect } from './common/js/interconnect.js'

export default {
  timeUpdateTimer: null,

  async onCreate() {
    // 将常用模块挂载到 global
    global.uiAdm = uiAdm
    global.storageManager = storageManager
    global.fetchManager = fetchManager

    uiAdm.initAdm()
    this.updateTime()
    initInterconnect()
    this.timeUpdateTimer = setInterval(() => this.updateTime(), 1000)
    this.initializeApp()
  },

  async initializeApp() {
    const device = await getDeviceInfo()
    const set = await getSettings()
    const indexPage = global.pagePool.get('pages/index')
    if (!device) {
      app.terminate()
      return
    }
    await storageManager.init() 
    // API Key 检查
    if (!global.APIKey) {
      router.replace({ uri: '/pages/init' })
      return
    }
    if (global.NetworkStatus === 'none' || !global.fetchAva) {
      return
    }
    // xxxx，这里可以使用indexPage.[对应页面的函数名称]做到无需跳转页面也能进行函数执行的操作（常用于后台刷新操作）

    global.runGC()
  },

  updateTime() {
    const now = new Date()
    global.NowHour = now.getHours().toString().padStart(2, '0')
    global.NowMin = now.getMinutes().toString().padStart(2, '0')
    uiAdm.UpdateTime(global.NowHour + ':' + global.NowMin)
  },

  onDestroy() {
    clearInterval(this.timeUpdateTimer)
  }
}
</script>
